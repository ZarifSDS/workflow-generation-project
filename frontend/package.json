{
  "name": "workflow-studio-editor",
  "private": true,
  "version": "0.0.0",
  "description": "Rich-text editor for step output in the run workspace (M9, docs/ui-ux-plan.md). Bundled with esbuild into apps/studio/static/studio/editor/.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-bubble-menu": "3.31.3",
    "@tiptap/extension-file-handler": "3.31.3",
    "@tiptap/extension-heading": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/markdown": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/suggestion": "3.31.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  }
}
