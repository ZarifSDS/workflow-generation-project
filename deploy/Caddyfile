# Share mode (docker-compose.share.yml): plain HTTP behind the ngrok tunnel, which terminates TLS.
{
	admin off
	auto_https off
	servers {
		# Keep ngrok's X-Forwarded-Proto/For (it reaches us from the Docker network), so Django
		# knows the original request was HTTPS.
		trusted_proxies static private_ranges
	}
}

:80 {
	import /etc/caddy/routes.caddy
}
