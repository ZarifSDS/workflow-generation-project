# Shared by deploy/Caddyfile (share mode) and deploy/Caddyfile.prod (production).
encode zstd gzip

# Uploads: images up to 10 MB, documents (PDFs) up to 25 MB, plus form overhead (Django enforces the limits)
request_body {
	max_size 30MB
}

handle_path /media/* {
	root * /srv/media
	file_server
	header Cache-Control "public, max-age=86400"
	# SVG images can carry scripts: sandbox them when opened directly (same as SvgSandboxMiddleware)
	@svg path *.svg *.SVG
	header @svg Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; sandbox"
}

handle {
	reverse_proxy {
		# Re-resolves the `web` service name, so scaled replicas join and leave automatically.
		dynamic a {
			name web
			port 8000
			refresh 10s
		}
		lb_policy round_robin
		lb_try_duration 5s
		fail_duration 30s
	}
}
