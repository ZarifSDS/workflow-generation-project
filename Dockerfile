# Based on the Dockerfile generated by `wagtail start` (Wagtail 8.0), adapted for
# Postgres, a separate migrate step and an optional dev-dependencies build.

# ---- Frontend stage: bundle the step-output editor (frontend/, docs/development.md) ----
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS frontend

WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Writes /src/apps/studio/static/studio/editor/editor.{js,css}
RUN npm run build


# ---- Build stage: compile Python packages into a virtualenv ----
FROM python:3.13-slim-trixie AS builder

RUN apt-get update --yes --quiet && apt-get install --yes --quiet --no-install-recommends \
    build-essential \
    libpq-dev \
    libjpeg62-turbo-dev \
    zlib1g-dev \
    libwebp-dev \
 && rm -rf /var/lib/apt/lists/* \
 && python -m venv /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

# requirements.txt for production images; requirements-dev.txt adds pytest and ruff.
ARG REQUIREMENTS=requirements.txt
COPY requirements.txt requirements-dev.txt /
RUN pip install --no-cache-dir -r /${REQUIREMENTS}

# NLTK's CMU pronouncing dictionary, which textstat uses to count syllables for reading grades.
# Fetched at build time and checked against the SHA-256 in NLTK's data index: downloading it at
# runtime fails (NLTK 3.10.3's downloader rejects its own temporary file) and would leave steps stuck.
ARG CMUDICT_URL=https://raw.githubusercontent.com/nltk/nltk_data/gh-pages/packages/corpora/cmudict.zip
ARG CMUDICT_SHA256=d07cca47fd72ad32ea9d8ad1219f85301eeaf4568f8b6b73747506a71fb5afd6
RUN python -c "import hashlib, io, sys, urllib.request, zipfile; \
data = urllib.request.urlopen(sys.argv[1], timeout=60).read(); \
assert hashlib.sha256(data).hexdigest() == sys.argv[2], 'cmudict checksum mismatch'; \
zipfile.ZipFile(io.BytesIO(data)).extractall('/opt/venv/nltk_data/corpora')" \
    "${CMUDICT_URL}" "${CMUDICT_SHA256}"


# ---- Runtime stage ----
FROM python:3.13-slim-trixie AS runtime

RUN apt-get update --yes --quiet && apt-get install --yes --quiet --no-install-recommends \
    libpq5 \
    libjpeg62-turbo \
    libwebp7 \
    libcairo2 \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home wagtail

EXPOSE 8000

ENV PYTHONUNBUFFERED=1 \
    PORT=8000 \
    PATH="/opt/venv/bin:$PATH" \
    DJANGO_SETTINGS_MODULE=config.settings.production

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
RUN mkdir -p /app/media && chown -R wagtail:wagtail /app

COPY --chown=wagtail:wagtail . .
# The editor bundle, before collectstatic picks it up.
COPY --from=frontend --chown=wagtail:wagtail /src/apps/studio/static/studio/editor/ /app/apps/studio/static/studio/editor/

USER wagtail

# Collect static files at build time. The key is a throwaway placeholder:
# collectstatic doesn't sign anything, and the real key comes from .env at runtime.
RUN DJANGO_SECRET_KEY=build-only-placeholder python manage.py collectstatic --noinput --clear

# Migrations run in the one-shot `migrate` service (see docker-compose.yml),
# not on every web start.
CMD ["sh", "-c", "gunicorn config.wsgi:application --bind 0.0.0.0:${PORT} --workers ${GUNICORN_WORKERS:-3} --timeout 120"]
