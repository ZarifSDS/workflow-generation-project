# Copy to .env and fill in. .env is git-ignored: never commit real keys.

# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
WAGTAILADMIN_BASE_URL=http://localhost:8000
TIME_ZONE=Asia/Dhaka
LOG_LEVEL=INFO

# --- Postgres (used by the db container and to build DATABASE_URL) ---
POSTGRES_DB=studio
POSTGRES_USER=studio
POSTGRES_PASSWORD=change-me

# --- Host services (GPU work stays on the Windows host) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
COMFYUI_BASE_URL=http://host.docker.internal:8188

# --- Encryption key for provider API keys stored in Settings › AI providers (ADR 0008). ---
# Generate: docker compose exec web python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it with .env, never in the database. Rotate: put the new key first, comma-separated with the old
# one, restart, run `python manage.py rotate_provider_keys`, then drop the old key. Losing it means
# entering the stored keys again.
STUDIO_SECRETS_KEY=

# --- Optional free API providers (milestone M2). Leave blank to disable. ---
# A key stored in Settings › AI providers takes precedence over these.
# Free tiers may use prompts for training: never send confidential material.
GEMINI_API_KEY=
OLLAMA_CLOUD_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Not usable in this deployment (see docs/providers.md), kept for completeness:
NVIDIA_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# --- Optional publish webhook (milestone M7), e.g. an n8n Webhook node. ---
# n8n in Docker on the same host: http://host.docker.internal:5678/webhook/<path>
STUDIO_PUBLISH_WEBHOOK_URL=
# If set, each request carries X-Studio-Signature: sha256=<HMAC-SHA256 of the body>.
STUDIO_WEBHOOK_SECRET=

# --- Sharing through an ngrok tunnel (docker-compose.share.yml, docs/deployment.md). ---
# Either reuse the Windows ngrok agent's config (`ngrok config check` shows it; forward slashes)...
NGROK_CONFIG_FILE=
# ...or give the authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional: a reserved domain, without https://. Empty = your account's free dev domain.
NGROK_DOMAIN=
# The public address people use, for links the studio builds, e.g. https://name.ngrok-free.dev
STUDIO_PUBLIC_URL=
# gunicorn processes per web container (default 3)
GUNICORN_WORKERS=3

# --- Backups (service `backup`, docs/operations.md). ---
# Folder for the nightly database dump and media archive; default ./backups in the project.
BACKUP_DIR=
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_DAYS=14

# --- Production on your own server (docker-compose.prod.yml, docs/deployment.md). ---
# Domain whose DNS points at the server (ports 80 and 443 open), and an email for certificate notices.
STUDIO_DOMAIN=
ACME_EMAIL=
